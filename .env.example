# ---------------------------------------------------------------------------
# Copy to .env  (cp .env.example .env)  and fill in what you have.
# NEVER commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- Challenger: Keenable ---------------------------------------------------
# Optional. Omit entirely to use Keenable's documented anonymous free tier
# (POST /v1/search/public). A key raises limits and guarantees service.
# Free key (100k requests/month): https://app.keenable.ai/signup
KEENABLE_API_KEY=
# Sent as the X-Keenable-Title header; identifies your app to the service.
KEENABLE_APP_ID=search-benchmark

# --- Incumbent: Exa ---------------------------------------------------------
# Required for the default comparison. https://dashboard.exa.ai
# Any engine speaking a similar JSON search API can be adapted in
# src/bench/providers.py — the harness only needs url/title/snippet per hit.
EXA_API_KEY=

# --- Judge: any OpenAI-compatible chat-completions endpoint ------------------
# Works with OpenAI, Azure OpenAI/Foundry, OpenRouter, vLLM, Ollama, LM Studio.
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_API_KEY=
JUDGE_MODEL=
# Optional
JUDGE_TEMPERATURE=0

# --- Optional ---------------------------------------------------------------
# Override the browser used for PDF rendering (otherwise auto-detected).
# BROWSER_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# BENCH_HTTP_TIMEOUT=40
